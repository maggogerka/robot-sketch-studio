# Local mode listens only on this computer. Set 0.0.0.0 for protected host mode.
SKETCHARM_HOST=127.0.0.1
SKETCHARM_PORT=8000
SKETCHARM_API_TOKEN=
SKETCHARM_DEVICE=auto

# Keep runtime data and downloaded weights outside the source package.
SKETCHARM_MODEL_DIR=./runtime/models
SKETCHARM_DATA_DIR=./runtime/data
SKETCHARM_RESULTS_DIR=./runtime/results
SKETCHARM_MAX_UPLOAD_MB=20
SKETCHARM_JOB_TTL_HOURS=24
SKETCHARM_CORS_ORIGINS=
SKETCHARM_MAX_WORKERS=2
SKETCHARM_QUEUE_SIZE=4

# Optional OpenAI-compatible endpoint (Ollama, vLLM, llama.cpp, LocalAI).
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
OLLAMA_API_KEY=

